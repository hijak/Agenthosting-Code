{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@agenthosting/cli",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "bun run --conditions=browser ./src/index.ts",
    "typecheck": "echo 'thin wrapper — typechecked via @mimo-ai/cli'",
    "build": "bun run script/build.ts"
  },
  "bin": {
    "ah": "./bin/ah"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@mimo-ai/cli": "workspace:*",
    "@mimo-ai/plugin": "workspace:*",
    "@mimo-ai/shared": "workspace:*",
    "effect": "catalog:",
    "open": "10.1.2",
    "yargs": "18.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/yargs": "17.0.33",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
