{
  "$schema": "https://agenthosting.app/docs/theme.json",
  "defs": {
    "surfaceBase": "#0E0E0F",
    "surfaceRaised": "#141415",
    "surfaceOverlay": "#19191A",
    "surfaceHover": "#1C1C1D",
    "surfaceActive": "#232325",
    "foreground": "#F5F5F5",
    "textSecondary": "#A3A3A3",
    "textMuted": "#9A9A9A",
    "textFaint": "#6E6E6E",
    "accent100": "#BAF8EC",
    "accent200": "#56F0D6",
    "accent300": "#0FCFB2",
    "accent400": "#109380",
    "accent500": "#126059",
    "orange100": "#FFE5B5",
    "orange200": "#FFC466",
    "orange300": "#FFA000",
    "orange400": "#B57009",
    "orange500": "#4D3712",
    "red100": "#FFCFCF",
    "red200": "#FF8B8B",
    "red300": "#FF3939",
    "red400": "#B82424",
    "red500": "#5A1818",
    "borderSubtle": "#212122",
    "borderBase": "#3E3E3F",
    "borderBright": "#5B5B5C",
    "borderStrong": "#939393"
  },
  "theme": {
    "primary": { "dark": "accent300", "light": "accent400" },
    "secondary": { "dark": "accent200", "light": "accent300" },
    "accent": { "dark": "accent200", "light": "accent300" },
    "error": { "dark": "red300", "light": "red400" },
    "warning": { "dark": "orange300", "light": "orange400" },
    "success": { "dark": "accent300", "light": "accent400" },
    "info": { "dark": "accent200", "light": "accent300" },
    "text": { "dark": "foreground", "light": "#0E0E0F" },
    "textMuted": { "dark": "textMuted", "light": "#6E6E6E" },
    "background": { "dark": "surfaceBase", "light": "#F5F5F5" },
    "backgroundPanel": { "dark": "surfaceRaised", "light": "#E8E8E8" },
    "backgroundElement": { "dark": "surfaceHover", "light": "#DCDCDC" },
    "border": { "dark": "borderBase", "light": "#C0C0C0" },
    "borderActive": { "dark": "accent300", "light": "accent400" },
    "borderSubtle": { "dark": "borderSubtle", "light": "#E0E0E0" },
    "diffAdded": { "dark": "accent300", "light": "accent400" },
    "diffRemoved": { "dark": "red300", "light": "red400" },
    "diffContext": { "dark": "textMuted", "light": "#9A9A9A" },
    "diffHunkHeader": { "dark": "textFaint", "light": "#6E6E6E" },
    "diffHighlightAdded": { "dark": "accent200", "light": "accent300" },
    "diffHighlightRemoved": { "dark": "red200", "light": "red300" },
    "diffAddedBg": { "dark": "#0a2e28", "light": "#e0f5f0" },
    "diffRemovedBg": { "dark": "#2e0a0a", "light": "#ffe0e0" },
    "diffContextBg": { "dark": "surfaceRaised", "light": "#E8E8E8" },
    "diffLineNumber": { "dark": "textFaint", "light": "#9A9A9A" },
    "diffAddedLineNumberBg": { "dark": "#0a2e28", "light": "#e0f5f0" },
    "diffRemovedLineNumberBg": { "dark": "#2e0a0a", "light": "#ffe0e0" },
    "markdownText": { "dark": "foreground", "light": "#0E0E0F" },
    "markdownHeading": { "dark": "accent300", "light": "accent400" },
    "markdownLink": { "dark": "accent200", "light": "accent300" },
    "markdownLinkText": { "dark": "accent100", "light": "accent200" },
    "markdownCode": { "dark": "accent300", "light": "accent400" },
    "markdownBlockQuote": { "dark": "textMuted", "light": "#9A9A9A" },
    "markdownEmph": { "dark": "orange200", "light": "orange300" },
    "markdownStrong": { "dark": "orange300", "light": "orange400" },
    "markdownHorizontalRule": { "dark": "borderBase", "light": "#C0C0C0" },
    "markdownListItem": { "dark": "accent300", "light": "accent400" },
    "markdownListEnumeration": { "dark": "accent200", "light": "accent300" },
    "markdownImage": { "dark": "accent200", "light": "accent300" },
    "markdownImageText": { "dark": "textSecondary", "light": "#A3A3A3" },
    "markdownCodeBlock": { "dark": "foreground", "light": "#0E0E0F" },
    "syntaxComment": { "dark": "textFaint", "light": "#6E6E6E" },
    "syntaxKeyword": { "dark": "accent200", "light": "accent300" },
    "syntaxFunction": { "dark": "accent300", "light": "accent400" },
    "syntaxVariable": { "dark": "foreground", "light": "#0E0E0F" },
    "syntaxString": { "dark": "orange200", "light": "orange300" },
    "syntaxNumber": { "dark": "accent100", "light": "accent200" },
    "syntaxType": { "dark": "accent200", "light": "accent300" },
    "syntaxOperator": { "dark": "orange300", "light": "orange400" },
    "syntaxPunctuation": { "dark": "textSecondary", "light": "#A3A3A3" }
  }
}
